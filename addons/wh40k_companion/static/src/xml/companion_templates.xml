<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="wh40k_companion.CompanionApp">
    <div class="wh40k-app o_wh40k_companion" t-att-class="{'wh40k-app-with-nav': this.showBottomNav}">
        <div t-if="this.state.error" class="wh40k-error" t-out="this.state.error"/>

        <t t-if="this.state.screen === 'nickname'">
            <t t-call="wh40k_companion.NicknameGate"/>
        </t>
        <t t-elif="this.state.screen === 'home' || this.state.screen === 'dashboard'">
            <t t-call="wh40k_companion.HomeScreen"/>
        </t>
        <t t-elif="this.state.screen === 'rosters'">
            <t t-call="wh40k_companion.RostersScreen"/>
        </t>
        <t t-elif="this.state.screen === 'import_preview'">
            <t t-call="wh40k_companion.ImportPreview"/>
        </t>
        <t t-elif="this.state.screen === 'create_match'">
            <t t-call="wh40k_companion.CreateMatch"/>
        </t>
        <t t-elif="this.state.screen === 'waiting'">
            <t t-call="wh40k_companion.WaitingScreen"/>
        </t>
        <t t-elif="this.state.screen === 'join'">
            <t t-call="wh40k_companion.JoinScreen"/>
        </t>
        <t t-elif="this.state.screen === 'game'">
            <t t-call="wh40k_companion.GameScreen"/>
        </t>
        <t t-elif="this.state.screen === 'result'">
            <t t-call="wh40k_companion.MatchResultScreen"/>
        </t>

        <nav t-if="this.showBottomNav" class="wh40k-bottom-nav" aria-label="Основная навигация">
            <button type="button" class="wh40k-nav-circle"
                    t-att-class="{'active': this.state.screen === 'rosters' || this.state.screen === 'import_preview'}"
                    t-on-click="() => this.setScreen('rosters')"
                    aria-label="Мои ростеры" title="Мои ростеры">
                <span class="wh40k-nav-glyph" aria-hidden="true">R</span>
                <span class="wh40k-nav-label">Ростеры</span>
            </button>
            <button type="button" class="wh40k-nav-circle wh40k-nav-create"
                    t-att-class="{'active': this.state.screen === 'create_match'}"
                    t-on-click="() => this.setScreen('create_match')"
                    aria-label="Создать матч" title="Создать матч">
                <span class="wh40k-nav-glyph wh40k-nav-plus" aria-hidden="true">+</span>
                <span class="wh40k-nav-label">Матч</span>
            </button>
            <button type="button" class="wh40k-nav-circle wh40k-nav-home"
                    t-att-class="{'active': this.state.screen === 'home' || this.state.screen === 'dashboard'}"
                    t-on-click="() => this.setScreen('home')"
                    aria-label="Главная" title="Главная">
                <span class="wh40k-nav-glyph" aria-hidden="true">⌂</span>
                <span class="wh40k-nav-label">Главная</span>
            </button>
        </nav>
    </div>
</t>

<t t-name="wh40k_companion.NicknameGate">
    <section class="wh40k-panel">
        <h2>Профиль игрока</h2>
        <p class="wh40k-muted">Придумайте уникальный никнейм, чтобы попасть на главный экран.</p>
        <input class="wh40k-input" style="max-width: 280px;"
               t-att-value="this.state.player.nickname"
               t-on-change="this.onNicknameChange"
               placeholder="GogoGogo207"/>
        <button class="wh40k-btn wh40k-btn-primary" t-on-click="this.saveNickname" t-att-disabled="this.state.busy">
            Сохранить и продолжить
        </button>
    </section>
</t>

<t t-name="wh40k_companion.HomeScreen">
    <section class="wh40k-panel">
        <h2>Личный кабинет</h2>
        <t t-if="this.state.activeMatch">
            <div class="wh40k-resume-banner" role="status">
                <div class="wh40k-resume-copy">
                    <strong>Активный матч</strong>
                    <p class="wh40k-muted" style="margin: 0.25rem 0 0;"
                       t-out="this.activeMatchSummary"/>
                </div>
                <button type="button" class="wh40k-btn wh40k-btn-primary"
                        t-on-click="this.resumeActiveMatch"
                        t-att-disabled="this.state.busy">
                    Вернуться в матч
                </button>
            </div>
        </t>
        <div class="wh40k-row" style="margin-bottom: 0.75rem;">
            <input class="wh40k-input" style="max-width: 220px; margin: 0;"
                   t-att-value="this.state.player.nickname"
                   t-on-change="this.onNicknameChange"
                   placeholder="Nickname"/>
            <button class="wh40k-btn" t-on-click="this.saveNickname">Сохранить никнейм</button>
        </div>
        <div class="wh40k-stats">
            <div class="wh40k-stat"><div class="value" t-out="this.state.player.wins"/><div class="label">Wins</div></div>
            <div class="wh40k-stat"><div class="value" t-out="this.state.player.losses"/><div class="label">Losses</div></div>
            <div class="wh40k-stat"><div class="value" t-out="this.state.player.total_match"/><div class="label">Matches</div></div>
            <div class="wh40k-stat"><div class="value" t-out="(this.state.player.win_rate || 0).toFixed(0) + '%'"/><div class="label">Win rate</div></div>
        </div>
        <div class="wh40k-row" style="margin-top: 1rem;">
            <button class="wh40k-btn" t-on-click="this.openManualJoin">Присоединиться по QR / ссылке</button>
        </div>
    </section>
</t>

<t t-name="wh40k_companion.RostersScreen">
    <section class="wh40k-panel">
        <h2>Мои ростеры</h2>
        <div class="wh40k-row" style="margin-bottom: 0.75rem;">
            <input class="wh40k-file" type="file" accept="application/json,.json" t-ref="this.rosterFile" t-on-change="this.onRosterFile"/>
            <span class="wh40k-muted">Импортировать ростер (JSON)</span>
        </div>
        <p class="wh40k-muted">Выберите NewRecruit / Battlescribe JSON — сначала превью, затем подтверждение.</p>
        <ul class="wh40k-list">
            <t t-foreach="this.state.rosters" t-as="roster" t-key="roster.id">
                <li class="wh40k-list-item">
                    <div>
                        <strong t-out="roster.name"/>
                        <div class="wh40k-muted" t-out="roster.points_used + ' / ' + roster.points_limit + ' pts | ' + roster.unit_count + ' units'"/>
                    </div>
                </li>
            </t>
        </ul>
        <p t-if="!this.state.rosters.length" class="wh40k-muted">Нет ростеров. Импортируйте testdata/aufychi.json.</p>
    </section>
</t>

<t t-name="wh40k_companion.ImportPreview">
    <section class="wh40k-panel" t-if="this.state.importPreview">
        <h2>Превью ростера</h2>
        <p><strong t-out="this.state.importPreview.name"/></p>
        <p class="wh40k-muted"
           t-out="'Фракция: ' + this.state.importPreview.faction"/>
        <p class="wh40k-muted"
           t-out="'Очки: ' + this.state.importPreview.points_used + '/' + this.state.importPreview.points_limit"/>
        <label class="wh40k-muted">Юниты</label>
        <ul class="wh40k-list">
            <t t-foreach="this.state.importPreview.units" t-as="unitName" t-key="unitName_index">
                <li class="wh40k-list-item"><span t-out="unitName"/></li>
            </t>
        </ul>
        <div class="wh40k-row">
            <button class="wh40k-btn" t-on-click="this.cancelImportPreview">Отмена</button>
            <button class="wh40k-btn wh40k-btn-primary" t-on-click="this.confirmImportRoster" t-att-disabled="this.state.busy">
                Подтвердить импорт
            </button>
        </div>
    </section>
</t>

<t t-name="wh40k_companion.CreateMatch">
    <section class="wh40k-panel">
        <h2>Создать матч</h2>
        <label class="wh40k-muted">Лимит очков</label>
        <select class="wh40k-select" t-on-change="this.onPointsChange">
            <option value="2000" t-att-selected="this.state.create.points === '2000'">2000</option>
            <option value="1000" t-att-selected="this.state.create.points === '1000'">1000</option>
        </select>

        <label class="wh40k-muted">Миссия</label>
        <div class="wh40k-list" style="margin-bottom: 0.75rem;">
            <t t-foreach="this.state.missions" t-as="mission" t-key="mission.id">
                <button type="button" class="wh40k-list-item"
                        t-att-class="{'selected': this.state.create.mission_id === mission.id}"
                        t-on-click="() => this.selectMission(mission.id)">
                    <div>
                        <strong t-out="mission.name"/>
                        <div class="wh40k-muted" t-out="mission.deployment"/>
                        <div class="wh40k-muted" t-out="mission.description"/>
                    </div>
                </button>
            </t>
        </div>

        <label class="wh40k-muted">Ростер</label>
        <div class="wh40k-list" style="margin-bottom: 0.75rem;">
            <t t-foreach="this.eligibleHostRosters" t-as="roster" t-key="roster.id">
                <button type="button" class="wh40k-list-item"
                        t-att-class="{'selected': this.state.create.roster_id === roster.id}"
                        t-on-click="() => this.selectHostRoster(roster.id)">
                    <div>
                        <strong t-out="roster.name"/>
                        <div class="wh40k-muted" t-out="roster.points_used + ' pts'"/>
                    </div>
                </button>
            </t>
        </div>
        <button class="wh40k-btn wh40k-btn-primary" t-on-click="this.createAndPublish" t-att-disabled="this.state.busy">
            Создать
        </button>
        <p class="wh40k-muted" style="margin-top: 1rem;">Уже есть QR от хоста?</p>
        <button class="wh40k-btn" t-on-click="this.openManualJoin">Присоединиться по ссылке</button>
    </section>
</t>

<t t-name="wh40k_companion.WaitingScreen">
    <section class="wh40k-panel wh40k-qr">
        <h2>Ожидание противника...</h2>
        <div class="wh40k-countdown" t-out="this.countdownLabel"/>
        <p class="wh40k-muted">QR действует 15 минут. После таймаута матч отменится автоматически.</p>
        <img t-att-src="this.qrImageUrl" alt="Match QR code"/>
        <code t-out="this.state.waiting.join_url"/>
        <div class="wh40k-row">
            <button class="wh40k-btn" t-on-click="this.refreshMatch">Обновить</button>
            <button class="wh40k-btn wh40k-btn-danger" t-on-click="this.cancelWaiting">Отменить матч</button>
        </div>
    </section>
</t>

<t t-name="wh40k_companion.JoinScreen">
    <section class="wh40k-panel">
        <h2 t-if="this.state.join.step === 'token'">Присоединиться</h2>
        <h2 t-elif="this.state.join.step === 'loading'">Открываем матч…</h2>
        <h2 t-elif="this.state.join.step === 'invite'">Приглашение</h2>
        <h2 t-else="">Выбор ростера</h2>

        <t t-if="this.state.join.step === 'loading'">
            <p class="wh40k-muted">Загружаем приглашение по ссылке из QR…</p>
        </t>

        <t t-elif="this.state.join.step === 'token'">
            <label class="wh40k-muted">Токен или ссылка из QR</label>
            <input class="wh40k-input" t-att-value="this.state.join.token" t-on-input="this.onJoinTokenChange" t-on-change="this.onJoinTokenChange" placeholder="UUID token / join URL"/>
            <button class="wh40k-btn wh40k-btn-primary" t-on-click="this.verifyToken" t-att-disabled="this.state.busy">Проверить</button>
        </t>

        <t t-elif="this.state.join.step === 'invite'">
            <div class="wh40k-invite-card">
                <h3 t-out="this.state.join.host_nickname + ' приглашает вас в матч'"/>
                <p class="wh40k-muted"
                   t-out="'Лимит очков: ' + this.state.join.points"/>
                <p class="wh40k-muted"
                   t-out="'Миссия: ' + this.state.join.mission_name"/>
                <p class="wh40k-muted"
                   t-out="'Ростер хоста: ' + this.state.join.host_roster_name + ' (' + this.state.join.host_roster_faction + ', ' + this.state.join.host_roster_points + ' очков)'"/>
                <div class="wh40k-row">
                    <button class="wh40k-btn" t-on-click="this.declineInvite">Отклонить</button>
                    <button class="wh40k-btn wh40k-btn-success" t-on-click="this.acceptInvite" t-att-disabled="this.state.busy">Принять</button>
                </div>
            </div>
        </t>

        <t t-elif="this.state.join.step === 'selecting'">
            <p class="wh40k-muted">Выберите ростер (очки ≤ лимита матча)</p>
            <div class="wh40k-list" style="margin-bottom: 0.75rem;">
                <t t-foreach="this.state.join.rosters" t-as="roster" t-key="roster.id">
                    <button type="button" class="wh40k-list-item"
                            t-att-class="{'selected': this.state.join.roster_id === roster.id}"
                            t-on-click="() => this.selectGuestRoster(roster.id)">
                        <div>
                            <strong t-out="roster.name"/>
                            <div class="wh40k-muted" t-out="roster.points_used + ' pts'"/>
                        </div>
                    </button>
                </t>
            </div>
            <p t-if="!this.state.join.rosters.length" class="wh40k-muted">Нет подходящих ростеров для этого лимита.</p>
            <button class="wh40k-btn wh40k-btn-success" t-on-click="this.joinMatch" t-att-disabled="this.state.busy">Подтвердить</button>
        </t>
    </section>
</t>

<t t-name="wh40k_companion.GameScreen">
    <section class="wh40k-panel">
        <div class="wh40k-side-title">
            <h2 style="margin:0;">Бой</h2>
            <button class="wh40k-btn wh40k-btn-danger" t-on-click="this.openSurrenderModal">Закончить матч</button>
        </div>
        <p class="wh40k-muted" t-out="this.missionName()"/>
        <p class="wh40k-swipe-hint">Свайп влево/вправо или вкладки — ваш ростер ↔ противник. Иконка § переключает юниты/правила внутри текущей стороны. -W / -M / Destroy / Undo — только ваш ростер.</p>
    </section>

    <div class="wh40k-game" t-att-data-side="this.state.gameSide">
        <div class="wh40k-game-nav">
            <div class="wh40k-game-tabs" role="tablist" aria-label="Сторона боя">
                <button type="button"
                        class="wh40k-game-tab"
                        role="tab"
                        t-att-class="{'active': this.state.gameSide === 'own'}"
                        t-att-aria-selected="this.state.gameSide === 'own' ? 'true' : 'false'"
                        t-on-click="() => this.setGameSide('own')">
                    <span class="wh40k-game-tab-label" t-out="this.ownSideLabel"/>
                    <span class="wh40k-muted">Вы</span>
                </button>
                <button type="button"
                        class="wh40k-game-tab"
                        role="tab"
                        t-att-class="{'active': this.state.gameSide === 'opponent'}"
                        t-att-aria-selected="this.state.gameSide === 'opponent' ? 'true' : 'false'"
                        t-on-click="() => this.setGameSide('opponent')">
                    <span class="wh40k-game-tab-label" t-out="this.oppSideLabel"/>
                    <span class="wh40k-muted">Противник</span>
                </button>
            </div>
            <div class="wh40k-game-dots" aria-hidden="true">
                <span class="wh40k-game-dot" t-att-class="{'active': this.state.gameSide === 'own'}"/>
                <span class="wh40k-game-dot" t-att-class="{'active': this.state.gameSide === 'opponent'}"/>
            </div>
        </div>

        <div class="wh40k-game-swipe"
             t-on-touchstart="this.onGameSwipeStart"
             t-on-touchend="this.onGameSwipeEnd"
             t-on-touchcancel="this.onGameSwipeCancel">
            <div class="wh40k-game-track"
                 t-att-class="{'wh40k-game-track-opp': this.state.gameSide === 'opponent'}">
                <section class="wh40k-panel wh40k-game-pane wh40k-game-pane-own" data-pane="own">
                    <div class="wh40k-side-title">
                        <div class="wh40k-pane-heading">
                            <h3 style="margin:0;" t-out="this.ownSideLabel"/>
                            <span class="wh40k-muted">Вы · редактирование</span>
                        </div>
                        <button type="button"
                                class="wh40k-btn wh40k-rules-toggle"
                                t-att-class="{'active': this.state.ownPaneMode === 'rules'}"
                                t-att-aria-pressed="this.state.ownPaneMode === 'rules' ? 'true' : 'false'"
                                t-att-title="this.state.ownPaneMode === 'rules' ? 'Показать ростер' : 'Правила армии'"
                                t-on-click="this.toggleOwnPaneMode">
                            <span class="wh40k-rules-icon" aria-hidden="true">§</span>
                            <span t-out="this.state.ownPaneMode === 'rules' ? 'Ростер' : 'Правила'"/>
                        </button>
                    </div>

                    <t t-if="this.state.ownPaneMode === 'rules'">
                        <div class="wh40k-pane-rules">
                            <t t-foreach="this.ownRules" t-as="rule" t-key="'own-' + rule.name + rule.scope">
                                <div class="wh40k-rule-block">
                                    <strong t-out="rule.name"/>
                                    <span class="wh40k-muted" t-out="' (' + rule.scope + ')'"/>
                                    <div class="wh40k-muted" style="white-space: pre-wrap;" t-out="rule.description"/>
                                </div>
                            </t>
                            <p t-if="!this.ownRules.length" class="wh40k-muted">Нет army/detachment правил для вашего ростера.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="this.ownUnits" t-as="unit" t-key="unit.unit_id">
                            <div class="wh40k-unit-card" t-att-class="{'destroyed': unit.destroyed}"
                                 t-on-click="() => this.openDatasheet(unit)">
                                <strong t-out="unit.name"/>
                                <div class="wh40k-muted" t-out="this.unitStatusLabel(unit)"/>
                                <div class="wh40k-unit-actions">
                                    <button class="wh40k-btn" t-on-click.stop="() => this.adjustUnit(unit, 'wounds', -1)">-W</button>
                                    <button class="wh40k-btn" t-on-click.stop="() => this.adjustUnit(unit, 'wounds', 1)">+W</button>
                                    <button class="wh40k-btn" t-on-click.stop="() => this.adjustUnit(unit, 'models', -1)">-M</button>
                                    <button class="wh40k-btn" t-on-click.stop="() => this.adjustUnit(unit, 'models', 1)">+M</button>
                                    <button class="wh40k-btn wh40k-btn-danger" t-on-click.stop="() => this.destroyUnit(unit)">Destroy</button>
                                    <button class="wh40k-btn wh40k-btn-undo"
                                            t-att-disabled="!this.canUndo(unit)"
                                            t-on-click.stop="() => this.undoUnit(unit)">Undo</button>
                                </div>
                            </div>
                        </t>
                        <p t-if="!this.ownUnits.length" class="wh40k-muted">Нет юнитов.</p>
                    </t>
                </section>

                <section class="wh40k-panel wh40k-game-pane wh40k-game-pane-opp" data-pane="opponent">
                    <div class="wh40k-side-title">
                        <div class="wh40k-pane-heading">
                            <h3 style="margin:0;" t-out="this.oppSideLabel"/>
                            <span class="wh40k-muted">Противник (только просмотр)</span>
                        </div>
                        <button type="button"
                                class="wh40k-btn wh40k-rules-toggle"
                                t-att-class="{'active': this.state.oppPaneMode === 'rules'}"
                                t-att-aria-pressed="this.state.oppPaneMode === 'rules' ? 'true' : 'false'"
                                t-att-title="this.state.oppPaneMode === 'rules' ? 'Показать ростер' : 'Правила армии противника'"
                                t-on-click="this.toggleOppPaneMode">
                            <span class="wh40k-rules-icon" aria-hidden="true">§</span>
                            <span t-out="this.state.oppPaneMode === 'rules' ? 'Ростер' : 'Правила'"/>
                        </button>
                    </div>

                    <t t-if="this.state.oppPaneMode === 'rules'">
                        <div class="wh40k-pane-rules">
                            <t t-foreach="this.oppRules" t-as="rule" t-key="'opp-' + rule.name + rule.scope">
                                <div class="wh40k-rule-block">
                                    <strong t-out="rule.name"/>
                                    <span class="wh40k-muted" t-out="' (' + rule.scope + ')'"/>
                                    <div class="wh40k-muted" style="white-space: pre-wrap;" t-out="rule.description"/>
                                </div>
                            </t>
                            <p t-if="!this.oppRules.length" class="wh40k-muted">Нет army/detachment правил у противника.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="this.oppUnits" t-as="unit" t-key="unit.unit_id">
                            <div class="wh40k-unit-card wh40k-unit-readonly" t-att-class="{'destroyed': unit.destroyed}"
                                 t-on-click="() => this.openDatasheet(unit)">
                                <strong t-out="unit.name"/>
                                <div class="wh40k-muted" t-out="this.unitStatusLabel(unit)"/>
                                <div class="wh40k-muted wh40k-readonly-hint">Даташит · без изменения состояния</div>
                            </div>
                        </t>
                        <p t-if="!this.oppUnits.length" class="wh40k-muted">Нет юнитов противника.</p>
                    </t>
                </section>
            </div>
        </div>
    </div>

    <t t-if="this.state.datasheet">
        <div class="wh40k-modal-backdrop" t-on-click="this.closeDatasheet">
            <div class="wh40k-modal" t-on-click.stop="">
                <div class="wh40k-side-title">
                    <h3 style="margin:0;" t-out="this.state.datasheet.name"/>
                    <button class="wh40k-btn" t-on-click="this.closeDatasheet">Close</button>
                </div>
                <t t-foreach="this.state.datasheet.models || []" t-as="model" t-key="model.id">
                    <h4 t-out="model.name + ' ×' + model.quantity"/>
                    <table>
                        <tr><th>M</th><th>T</th><th>Sv</th><th>W</th><th>LD</th><th>OC</th><th>InSv</th></tr>
                        <tr>
                            <td t-out="model.M"/><td t-out="model.T"/><td t-out="model.Sv"/>
                            <td t-out="model.W"/><td t-out="model.LD"/><td t-out="model.OC"/><td t-out="model.InSv"/>
                        </tr>
                    </table>
                    <t t-foreach="model.weapons || []" t-as="w" t-key="w.name">
                        <div>
                            <strong t-out="w.name"/>
                            <span class="wh40k-muted" t-out="this.weaponLabel(w)"/>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </t>

    <t t-if="this.state.showSurrenderModal">
        <div class="wh40k-modal-backdrop" t-on-click="this.closeSurrenderModal">
            <div class="wh40k-modal" t-on-click.stop="">
                <h3>Вы уверены, что хотите сдаться?</h3>
                <p class="wh40k-muted">Это действие нельзя отменить. Ваш противник будет объявлен победителем.</p>
                <div class="wh40k-row">
                    <button class="wh40k-btn" t-on-click="this.closeSurrenderModal">Отмена</button>
                    <button class="wh40k-btn wh40k-btn-danger" t-on-click="this.confirmSurrender" t-att-disabled="this.state.busy">Да, сдаться</button>
                </div>
            </div>
        </div>
    </t>
</t>

<t t-name="wh40k_companion.MatchResultScreen">
    <section class="wh40k-panel" style="text-align:center;">
        <h2 t-out="this.state.result.you_won ? 'Победа!' : 'Поражение'"/>
        <p style="font-size: 1.2rem; font-weight: 600;" t-out="this.state.result.message"/>
        <p class="wh40k-muted">Победитель: <t t-out="this.state.result.winner_nickname"/></p>
        <button class="wh40k-btn wh40k-btn-primary" t-on-click="() => this.setScreen('dashboard')">На главный экран</button>
    </section>
</t>

</templates>
