<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="landing_page" name="WH40k Companion Landing">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" type="text/css" href="/wh40k_companion/static/src/css/companion.css"/>
                <style>
                    body { margin: 0; background: #0e1319; }
                    .wh40k-public { max-width: 520px; margin: 4rem auto; padding: 1rem; }
                </style>
            </t>
            <div class="wh40k-app wh40k-public">
                <header class="wh40k-header">
                    <h1 class="wh40k-brand">WH40k <span>Companion</span></h1>
                </header>
                <section class="wh40k-panel">
                    <h2>Battle ready</h2>
                    <p class="wh40k-muted">Register a commander profile, import NewRecruit rosters, and fight via QR matchmaking.</p>
                    <div t-if="error" class="wh40k-error" t-out="error"/>
                    <div t-if="message" class="wh40k-muted" t-out="message"/>
                    <div class="wh40k-row">
                        <a class="wh40k-btn wh40k-btn-primary" href="/wh40k/signup">Зарегистрироваться</a>
                        <a class="wh40k-btn" href="/web/login?redirect=/wh40k/app">Войти</a>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="signup_page" name="WH40k Companion Signup">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" type="text/css" href="/wh40k_companion/static/src/css/companion.css"/>
                <style>
                    body { margin: 0; background: #0e1319; }
                    .wh40k-public { max-width: 520px; margin: 3rem auto; padding: 1rem; }
                </style>
            </t>
            <div class="wh40k-app wh40k-public">
                <header class="wh40k-header">
                    <h1 class="wh40k-brand">WH40k <span>Companion</span></h1>
                </header>
                <section class="wh40k-panel">
                    <h2>Регистрация</h2>
                    <p class="wh40k-muted">Создайте аккаунт и игровой профиль с уникальным никнеймом.</p>
                    <div t-if="error" class="wh40k-error" t-out="error"/>
                    <form action="/wh40k/signup" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label class="wh40k-muted">Email</label>
                        <input class="wh40k-input" type="email" name="email" required="required" t-att-value="email"/>
                        <label class="wh40k-muted">Пароль</label>
                        <input class="wh40k-input" type="password" name="password" required="required" minlength="8"/>
                        <label class="wh40k-muted">Никнейм</label>
                        <input class="wh40k-input" type="text" name="nickname" required="required" minlength="3" t-att-value="nickname" placeholder="GogoGogo207"/>
                        <div class="wh40k-row">
                            <button class="wh40k-btn wh40k-btn-primary" type="submit">Создать профиль</button>
                            <a class="wh40k-btn" href="/wh40k">Назад</a>
                        </div>
                    </form>
                </section>
            </div>
        </t>
    </template>
</odoo>
