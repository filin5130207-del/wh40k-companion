<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wh40k_roster_list" model="ir.ui.view">
        <field name="name">wh40k.roster.list</field>
        <field name="model">wh40k.roster</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="game_system"/>
                <field name="points_used"/>
                <field name="points_limit"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="view_wh40k_roster_form" model="ir.ui.view">
        <field name="name">wh40k.roster.form</field>
        <field name="model">wh40k.roster</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="game_system"/>
                        </group>
                        <group>
                            <field name="points_used"/>
                            <field name="points_limit"/>
                            <field name="unit_count"/>
                            <field name="weapon_count"/>
                            <field name="ability_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Forces">
                            <field name="force_ids">
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="catalogue_name"/>
                                        <field name="army_rule_ids" widget="many2many_tags"/>
                                    </group>
                                    <field name="detachment_ids">
                                        <form>
                                            <group>
                                                <field name="name"/>
                                                <field name="detachment_rule_ids" widget="many2many_tags"/>
                                            </group>
                                            <field name="unit_ids">
                                                <list>
                                                    <field name="name"/>
                                                    <field name="quantity"/>
                                                    <field name="points"/>
                                                    <field name="keywords"/>
                                                </list>
                                            </field>
                                        </form>
                                    </field>
                                </form>
                                <list>
                                    <field name="name"/>
                                    <field name="catalogue_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wh40k_roster" model="ir.actions.act_window">
        <field name="name">Rosters</field>
        <field name="res_model">wh40k.roster</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
