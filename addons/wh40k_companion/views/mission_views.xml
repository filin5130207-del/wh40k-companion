<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wh40k_mission_list" model="ir.ui.view">
        <field name="name">wh40k.mission.list</field>
        <field name="model">wh40k.mission</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="deployment"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wh40k_mission_form" model="ir.ui.view">
        <field name="name">wh40k.mission.form</field>
        <field name="model">wh40k.mission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="deployment"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wh40k_mission" model="ir.actions.act_window">
        <field name="name">Missions</field>
        <field name="res_model">wh40k.mission</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
